pipeline {
    agent any

    environment {
        DATABASE_URL      = credentials('DATABASE_URL')
        RENDER_DEPLOY_URL = credentials('RENDER_DEPLOY_HOOK_URL')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t matchme-test .'
            }
        }

        stage('Start App Container') {
            steps {
                sh '''
                    docker run -d \
                        --name matchme-app \
                        -p 3000:3000 \
                        -e DATABASE_URL=$DATABASE_URL \
                        matchme-test
                    sleep 5
                '''
            }
        }

        stage('Install Playwright') {
            steps {
                sh 'pip install pytest-playwright && playwright install chromium'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'pytest tests/ -v'
            }
        }

    }

    post {
        always {
            sh '''
                docker stop matchme-app || true
                docker rm   matchme-app || true
            '''
        }
        success {
            echo 'Tests passed! Deploying to Render...'
            sh 'curl -X POST $RENDER_DEPLOY_URL'
        }
        failure {
            echo 'Tests failed. Deploy skipped.'
        }
    }
}